# this file is to be sourced by .bash_profile

alias vi=vim
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'
alias ls='ls --color'
alias ll='ls -lhA --color'
alias tg=terragrunt
alias ddrush='ddev drush'
alias g=git

alias dlogs='ddev logs -f --tail 200 |txts --color-always -n ddev_logs'

alias tm='tmux'
alias tma='tmux attach'

# TrueNAS SCALE: keep full colors for me, but never pass giant LS_COLORS to sudo
[ -x /usr/bin/midclt ] && alias sudo='unset LS_COLORS 2>/dev/null; command sudo'
